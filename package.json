{
  "name": "@ameria/vpos-sdk",
  "version": "0.0.15",
  "description": "Unofficial Node.js SDK for the Ameriabank vPOS payment API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": "github:hos/ameria-sdk-js",
  "author": "hos <hovosanoyan@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepack": "yarn build",
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "yarn build && node --test test/client.test.mjs",
    "docs": "typedoc src/index.ts"
  },
  "files": [
    "dist/**"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "packageManager": "yarn@4.18.1"
}
